# Headcount Environment Variables
# Copy to .env.local and fill in values

# Base RPC endpoint 
BASE_RPC_URL=https://mainnet.base.org

# Database URL
DATABASE_URL=

# WalletConnect Project ID
WALLETCONNECT_PROJECT_ID=

# Alchemy API key (free tier: 30M CUs/month)
ALCHEMY_API_KEY=

# Basescan API key (free tier)
BASESCAN_API_KEY=

# Groq API key (for narration layer only)
GROQ_API_KEY=

# Engine settings
DEFAULT_HOLDER_CAP=250
PROBE_BUDGET=6

# x402 payment settings
X402_RECEIVE_ADDRESS=
X402_FACILITATOR_URL=

# Telegram bot token
TELEGRAM_BOT_TOKEN=
